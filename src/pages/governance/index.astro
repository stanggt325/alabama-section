---
import { getCollection } from 'astro:content';
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import GovNav from '../../components/GovNav.astro';
import { OFFICERS, AREA_DIRECTOR } from '../../data/site';

const clubs = (await getCollection('clubs')).filter((c) => c.data.active).sort((a, b) => a.data.uspsaId.localeCompare(b.data.uspsaId));
---
<Base title="Governance" description="How the USPSA Alabama Section is run: the Section Coordinator, the Executive Committee, and the Area Director.">
  <PageHead title="Governance" lede="The Section is governed by an Executive Committee: the Section Coordinator as chair, plus the president (or a designated representative) of every member club, one vote each (Bylaws Art. 4-5). The Section Coordinator answers to the USPSA Area 6 Director." />
  <div class="container">
    <GovNav />

    <section class="section" style="padding-top:0">
      <h2>Officers</h2>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Role</th><th>Name</th><th>Club</th><th>Contact</th></tr></thead>
          <tbody>
            {OFFICERS.map((o) => (
              <tr>
                <td>{o.role}</td>
                <td>{o.name}</td>
                <td>{o.club || '—'}</td>
                <td>{o.email ? <a href={`mailto:${o.email}`}>{o.email}</a> : '—'}</td>
              </tr>
            ))}
            <tr>
              <td>{AREA_DIRECTOR.title}</td>
              <td>{AREA_DIRECTOR.name}</td>
              <td>—</td>
              <td><a href={AREA_DIRECTOR.url} rel="noopener" target="_blank">uspsa.org/area6</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>Executive Committee</h2>
      <p>One voting seat per member club, held by the club president or their designated representative (Art. 8). Each representative may bring one non-voting advisor (Art. 5.A).</p>
      <div class="callout"><p>Current representatives are being confirmed with each club by the Section Coordinator. Names will be posted here once confirmed.</p></div>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Club</th><th>ID</th><th>Representative</th></tr></thead>
          <tbody>
            {clubs.map((c) => (
              <tr>
                <td><a href={`/clubs/${c.id}/`}>{c.data.name}</a></td>
                <td>{c.data.uspsaId}</td>
                <td>{c.data.contact ?? <span class="soon">Coming soon</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>What the Section Coordinator does</h2>
      <div class="prose">
        <p>From USPSA's Section Operations and Governance Policy (§4), the Section Coordinator:</p>
        <ul>
          <li>Promotes USPSA, its rules, and its ideals within the Section.</li>
          <li>Keeps the Area Director and the national office informed of activity in the Section.</li>
          <li>Promotes the Area 6 Championship and USPSA Nationals, and distributes the Section's Nationals slots.</li>
          <li>Ensures every club's match results and activity fees reach USPSA within 30 days of the match.</li>
          <li>Recommends clubs for affiliation or disaffiliation to the Area Director.</li>
          <li>Visits each club at least once a year during a match.</li>
          <li>Helps new clubs form and affiliate.</li>
          <li>Renders a full accounting of Section funds to the clubs every year.</li>
          <li>Has jurisdiction over USPSA rules and policy matters within the Section (Bylaws Art. 7.A); the Executive Committee has jurisdiction over everything else (7.B). Neither has jurisdiction over a club's internal affairs (7.C).</li>
        </ul>
        <p>The Section Coordinator must hold current USPSA membership and an NROI Range Officer (Level I) or higher certification (Policy §3.2). The Area Director may remove a Section Coordinator for cause, subject to appeal to the USPSA Board (§3.4).</p>
      </div>
    </section>
  </div>
</Base>
