---
import { getCollection, render } from 'astro:content';
import PageHead from '../../../components/PageHead.astro';
import Base from '../../../layouts/Base.astro';
import { fmtDate } from '../../../lib/dates';

export async function getStaticPaths() {
  const minutes = await getCollection('minutes');
  return minutes.map((m) => ({ params: { id: m.id }, props: { m } }));
}
const { m } = Astro.props;
const { Content } = await render(m);
---
<Base title={`${m.data.title}, ${fmtDate(m.data.date)}`} description={`Minutes of the Alabama Section Executive Committee, ${fmtDate(m.data.date)}.`}>
  <PageHead title={m.data.title} plain eyebrow={`${m.data.kind} meeting`} back={{ href: '/governance/meetings/', label: 'All minutes' }}>
    <p class="lede">{fmtDate(m.data.date)}{m.data.location ? ` · ${m.data.location}` : ''}{m.data.pdf && <> · <a href={m.data.pdf}>Signed PDF</a></>}</p>
  </PageHead>
  <div class="container">
    <article class="prose"><Content /></article>
  </div>
</Base>
