---
import { getCollection, render } from 'astro:content';
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { fmtDate } from '../../lib/dates';

export async function getStaticPaths() {
  const notices = await getCollection('notices');
  return notices.map((notice) => ({ params: { id: notice.id }, props: { notice } }));
}
const { notice } = Astro.props;
const { Content } = await render(notice);
const { title, date, category, summary } = notice.data;
const LABEL: Record<string, string> = { election: 'Election notice', meeting: 'Meeting notice', bylaws: 'Bylaws', 'nationals-slots': 'Nationals slots', championship: 'Championship', clubs: 'Clubs', general: 'Section notice' };
---
<Base title={title} description={summary}>
  <PageHead title={title} plain eyebrow={LABEL[category]} back={{ href: '/notices/', label: 'All notices' }}>
    <p class="lede"><time datetime={date.toISOString()}>{fmtDate(date)}</time></p>
  </PageHead>
  <div class="container">
    <article class="prose">
      <Content />
    </article>
  </div>
</Base>
